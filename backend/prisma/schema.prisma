generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String?
  googleId  String?  @unique
  createdAt DateTime @default(now())
}

model Category {
  id           String    @id @default(cuid())
  name         String
  description  String?
  image        String?
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
}

model Product {
  id           String                  @id @default(cuid())
  name         String
  description  String?
  price        Float
  image        String?
  categoryId   String
  isActive     Boolean                 @default(true)
  displayOrder Int                     @default(0)
  rent12M      Float?
  deposit12M   Float?
  rent6M       Float?
  deposit6M    Float?
  rent3M       Float?
  deposit3M    Float?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  category     Category                @relation(fields: [categoryId], references: [id])
  images       ProductImage[]
  trendingIn   TrendingRentalProduct[]
}

model ProductImage {
  id        String   @id @default(cuid())
  imageUrl  String
  sortOrder Int      @default(0)
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Banner {
  id          String        @id @default(cuid())
  image       String
  topLabel    String        @default("NO INVESTMENT, JUST COMFORT")
  heading     String        @default("Furnish Your Home in Just 2 Days.")
  subtitle    String        @default("Delivery, Setup & Support — All Included. Starting at minimal rents across Pune & PCMC.")
  button1Text String        @default("VIEW CATEGORIES")
  button1Link String        @default("#categories")
  button2Text String        @default("CALL HOTLINE")
  button2Link String        @default("tel:+919423838109")
  isActive    Boolean       @default(true)
  placement   String        @default("HOMEPAGE_HERO")
  sortOrder   Int           @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  impressions Int           @default(0)
  clicks      Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  images      BannerImage[]
}

model BannerImage {
  id        String   @id @default(cuid())
  imageUrl  String
  sortOrder Int      @default(0)
  bannerId  String
  createdAt DateTime @default(now())
  banner    Banner   @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@index([bannerId, sortOrder])
}

model SiteSetting {
  id              Int      @id @default(autoincrement())
  whatsappNumber  String   @default("919423838109")
  whatsappMessage String   @default("Hi LIVEAZY! ")
  updatedAt       DateTime @updatedAt
}

model PromoBanner {
  id          String   @id @default(cuid())
  image       String
  label       String
  heading     String
  subtitle    String
  buttonText  String
  buttonLink  String   @default("#products")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  placement   String   @default("HOMEPAGE_PROMO")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clicks      Int      @default(0)
  impressions Int      @default(0)
}

model ContactPageSetting {
  id               Int      @id @default(1)
  pageTitle        String   @default("We're Here to Help")
  pageDescription  String   @default("Contact LIVEAZY for help with rental plans, product availability, delivery, and support.")
  supportEmail     String   @default("help@liveazy.in")
  supportPhone     String   @default("919423838109")
  serviceLocations String   @default("Pune & PCMC")
  supportHours     String   @default("Contact us for current support hours")
  updatedAt        DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  label     String   @default("GENERAL")
  question  String
  answer    String
  foot      String?
  iconName  String   @default("help-circle")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model ContactEnquiry {
  id         String               @id @default(cuid())
  fullName   String
  email      String
  phone      String
  category   String
  message    String
  status     ContactEnquiryStatus @default(PENDING)
  adminNotes String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model Feedback {
  id           String         @id @default(cuid())
  customerName String
  rating       Int
  message      String
  status       FeedbackStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, createdAt])
}

model TrendingRentalSetting {
  id        Int                     @id @default(1)
  heading   String                  @default("Trending Rentals in Your City")
  subtitle  String                  @default("Handpicked rentals for your home.")
  isActive  Boolean                 @default(true)
  updatedAt DateTime                @default(now()) @updatedAt
  products  TrendingRentalProduct[]
}

model TrendingRentalProduct {
  id        String                @id @default(cuid())
  settingId Int
  productId String
  sortOrder Int                   @default(0)
  product   Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  setting   TrendingRentalSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)

  @@unique([settingId, productId])
  @@index([settingId, sortOrder])
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

enum ContactEnquiryStatus {
  PENDING
  CONTACTED
  RESOLVED
}

enum FeedbackStatus {
  PENDING
  APPROVED
  REJECTED
}
