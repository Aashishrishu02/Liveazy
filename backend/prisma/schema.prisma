generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String?
  googleId  String?  @unique
  createdAt DateTime @default(now())
}

model Category{
  id String @id @default(cuid())
  name String 
  description String?
  image String?
  isActive Boolean @default(true)
  displayOrder Int @default(0)
  products Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  image       String?
  categoryId  String
  isActive    Boolean  @default(true)
  displayOrder Int @default(0)

  // 12-month rental plan
  rent12M    Float?
  deposit12M Float?

  // 6-month rental plan
  rent6M    Float?
  deposit6M Float?

  // 3-month rental plan
  rent3M    Float?
  deposit3M Float?

  category Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Banner {
  id          String   @id @default(cuid())
  image       String

  topLabel    String   @default("NO INVESTMENT, JUST COMFORT")
  heading     String   @default("Furnish Your Home in Just 2 Days.")
  subtitle    String   @default("Delivery, Setup & Support — All Included. Starting at minimal rents across Pune & PCMC.")

  button1Text String   @default("VIEW CATEGORIES")
  button1Link String   @default("#categories")
  button2Text String   @default("CALL HOTLINE")
  button2Link String   @default("tel:+919423838109")

  // Publishing status
  isActive    Boolean  @default(true)

  // Banner placement and ordering
  placement   String   @default("HOMEPAGE_HERO")
  sortOrder   Int      @default(0)

  // Optional publishing schedule
  startsAt    DateTime?
  endsAt      DateTime?

  // Actual engagement counters
  impressions Int      @default(0)
  clicks      Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id              Int      @id @default(autoincrement())
  whatsappNumber  String   @default("919423838109")
  whatsappMessage String   @default("Hi LIVEAZY! ")
  updatedAt       DateTime @updatedAt
}


model PromoBanner {
  id         String   @id @default(cuid())
  image      String
  label      String
  heading    String
  subtitle   String
  buttonText String
  buttonLink String @default("#products")
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  placement String @default("HOMEPAGE_PROMO")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
